# Public base URL of this connector (used for OAuth redirects and logging)
PUBLIC_URL=https://spot-price.example.com
PORT=7768

# ST Schema connector credentials (from `smartthings schema:create` output).
# SmartThings uses these to call us; we use them for state callbacks.
ST_CLIENT_ID=
ST_CLIENT_SECRET=

# OAuth credentials that SmartThings presents to our account-linking server
# (entered as "Partner OAuth client id/secret" in the Schema app registration)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Persistence
DB_PATH=./data/spot-price.db

# Price source
SPOT_API_BASE=https://api.spot-hinta.fi
